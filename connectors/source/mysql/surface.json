{
  "schema": "cowd.surface.v1",
  "id": "mysql",
  "name": "MySQL Source Connector",
  "version": "0.9.713",
  "kind": "source-connector",
  "runtime": {
    "kind": "managed",
    "artifact": "cowd-edge-sql-source",
    "driver_profile": "mysql",
    "transport": "uds-http2"
  },
  "capabilities": [
    "source.schema_discovery",
    "source.snapshot",
    "source.incremental",
    "source.event",
    "source.health"
  ],
  "routes": [],
  "resources": [],
  "health": {
    "mode": "http2",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": [],
    "optional": [
      "database_url",
      "database_url_env",
      "host",
      "port",
      "database",
      "database_name",
      "user",
      "username",
      "password"
    ]
  },
  "default_enabled": false
}
