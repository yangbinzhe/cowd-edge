{
  "schema": "cowd.surface.v1",
  "id": "postgres",
  "name": "PostgreSQL Source Connector",
  "version": "0.9.542",
  "kind": "source-connector",
  "entry": "./cowd-edge-postgres-source",
  "transport": "stdio-jsonl",
  "lifecycle": "managed",
  "capabilities": [
    "source.schema_discovery",
    "source.snapshot",
    "source.incremental",
    "source.event",
    "source.health"
  ],
  "routes": [],
  "resources": [],
  "health": {
    "mode": "jsonl",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": [],
    "optional": [
      "database_url",
      "database_url_env",
      "host",
      "port",
      "database",
      "database_name",
      "user",
      "username",
      "password"
    ]
  },
  "default_enabled": false
}
