{
  "schema": "cowd.surface.v1",
  "id": "lark-bitable",
  "name": "Lark Base Source Connector",
  "version": "0.9.547",
  "kind": "source-connector",
  "entry": "./cowd-edge-lark-bitable-source",
  "transport": "stdio-jsonl",
  "lifecycle": "managed",
  "capabilities": [
    "source.schema_discovery",
    "source.snapshot",
    "source.incremental",
    "source.event",
    "source.health"
  ],
  "routes": [],
  "resources": [],
  "health": {
    "mode": "jsonl",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": ["app_id", "app_secret"],
    "optional": ["base_url", "app_token", "table_id"]
  },
  "default_enabled": false
}
