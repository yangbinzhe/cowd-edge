{
  "schema": "cowd.surface.v1",
  "id": "lark-bitable",
  "name": "Lark Base Source Connector",
  "version": "0.9.641",
  "kind": "source-connector",
  "runtime": {
    "kind": "managed",
    "artifact": "cowd-edge-bitable-source",
    "driver_profile": "lark-bitable",
    "transport": "uds-http2"
  },
  "capabilities": [
    "source.schema_discovery",
    "source.snapshot",
    "source.incremental",
    "source.event",
    "source.health"
  ],
  "routes": [],
  "resources": [],
  "health": {
    "mode": "http2",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": [
      "app_id",
      "app_secret"
    ],
    "optional": [
      "base_url",
      "app_token",
      "table_id"
    ]
  },
  "default_enabled": false
}
