{
  "schema": "cowd.surface.v1",
  "id": "email",
  "name": "Email Message Connector",
  "version": "0.9.638",
  "kind": "message-connector",
  "runtime": {
    "kind": "managed",
    "artifact": "cowd-edge-email-message",
    "driver_profile": "email-message",
    "transport": "uds-http2"
  },
  "capabilities": [
    "message.ingress",
    "message.egress",
    "message.send.text",
    "message.send.document",
    "message.smtp",
    "message.imap",
    "message.health"
  ],
  "routes": [],
  "resources": [],
  "health": {
    "mode": "http2",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": [
      "smtp_host",
      "from_address"
    ]
  },
  "default_enabled": false
}
