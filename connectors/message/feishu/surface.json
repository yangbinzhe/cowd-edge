{
  "schema": "cowd.surface.v1",
  "id": "feishu",
  "name": "Feishu Message Connector",
  "version": "0.9.439",
  "kind": "message-connector",
  "entry": "./cowd-edge-feishu-message",
  "transport": "stdio-jsonl",
  "lifecycle": "managed",
  "capabilities": ["message.ingress", "message.egress", "message.callback", "message.health", "message.processing_lifecycle"],
  "routes": [
    {
      "kind": "callback",
      "path": "/events",
      "method": "POST",
      "public": true
    }
  ],
  "resources": [],
  "health": {
    "mode": "jsonl",
    "interval_ms": 30000
  },
  "config_schema": {
    "required": ["app_id", "app_secret"]
  },
  "default_enabled": false
}
