{
  "schema": "cowd.surface.v1",
  "id": "wechat-ilink",
  "name": "WeChat iLink Message Connector",
  "version": "0.9.626",
  "kind": "message-connector",
  "runtime": {
    "kind": "managed",
    "artifact": "cowd-edge-wechat-ilink-message",
    "driver_profile": "wechat-ilink-message",
    "transport": "uds-http2",
    "state": "persistent"
  },
  "capabilities": [
    "message.ingress",
    "message.egress",
    "message.send.text",
    "message.send.image",
    "message.chat.info",
    "message.qr_login",
    "message.long_poll",
    "message.health"
  ],
  "routes": [
    {
      "kind": "callback",
      "path": "/qr",
      "method": "POST",
      "public": false
    }
  ],
  "resources": [],
  "health": {
    "mode": "http2",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": []
  },
  "default_enabled": true
}
