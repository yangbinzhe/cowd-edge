{
  "schema": "cowd.surface.v1",
  "id": "wechat-ilink",
  "name": "WeChat iLink Message Connector",
  "version": "0.9.547",
  "kind": "message-connector",
  "entry": "./cowd-edge-wechat-ilink-message",
  "transport": "stdio-jsonl",
  "lifecycle": "managed",
  "capabilities": ["message.ingress", "message.egress", "message.qr_login", "message.long_poll", "message.health"],
  "routes": [
    {
      "kind": "callback",
      "path": "/qr",
      "method": "POST",
      "public": false
    }
  ],
  "resources": [],
  "health": {
    "mode": "jsonl",
    "interval_ms": 30000
  },
  "config_schema": {
    "required": ["bot_id", "bot_secret"]
  },
  "default_enabled": false
}
