{
  "schema": "cowd.surface.v1",
  "id": "wecom",
  "name": "WeCom Message Connector",
  "version": "0.9.643",
  "kind": "message-connector",
  "runtime": {
    "kind": "managed",
    "artifact": "cowd-edge-wecom-message",
    "driver_profile": "wecom-message",
    "transport": "uds-http2"
  },
  "capabilities": [
    "message.ingress",
    "message.egress",
    "message.send.text",
    "message.callback",
    "message.crypto",
    "message.health"
  ],
  "routes": [
    {
      "kind": "callback",
      "path": "/events",
      "method": "POST",
      "public": true
    }
  ],
  "resources": [],
  "health": {
    "mode": "http2",
    "interval_ms": 30000,
    "timeout_ms": 5000
  },
  "config_schema": {
    "required": [
      "corp_id",
      "corp_secret",
      "agent_id"
    ]
  },
  "default_enabled": false
}
