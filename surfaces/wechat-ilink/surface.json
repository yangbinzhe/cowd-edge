{
  "schema": "cowd.surface.v1",
  "id": "wechat-ilink",
  "name": "WeChat iLink Surface",
  "version": "0.9.417",
  "kind": "external-integration",
  "entry": "./cowd-surface-wechat-ilink",
  "transport": "stdio-jsonl",
  "lifecycle": "managed",
  "capabilities": ["ingress", "egress", "qr-login", "long-poll", "health"],
  "routes": [
    {
      "kind": "callback",
      "path": "/qr",
      "method": "POST",
      "public": false
    }
  ],
  "resources": [],
  "health": {
    "mode": "jsonl",
    "interval_ms": 30000
  },
  "config_schema": {
    "required": ["bot_id", "bot_secret"]
  },
  "default_enabled": false
}
