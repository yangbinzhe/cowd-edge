{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vitest/globals",
      "vite/client",
      "web-bluetooth"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "*.config.ts",
    "e2e/**/*.ts"
  ]
}
