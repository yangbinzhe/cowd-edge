{
  "name": "@cowd-edge/webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && mv dist/index.dev.html dist/index.html",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "npm run test:unit && npm run test:i18n && npm run test:governance && npm run test:api-matrix && npm run test:presentation-contract && npm run test:capability-parity && npm run test:raw-payload && npm run test:secondary-sections && npm run test:acceptance",
    "test:unit": "vitest run",
    "test:i18n": "node scripts/i18n-source-gate.mjs --gate && node scripts/i18n-coverage-gate.mjs --gate",
    "test:api-matrix": "node scripts/api-matrix.mjs --gate",
    "test:presentation-contract": "node scripts/presentation-contract-gate.mjs --gate",
    "test:capability-parity": "node scripts/capability-parity.mjs --gate",
    "test:secondary-sections": "node scripts/secondary-section-contract.mjs --gate",
    "test:raw-payload": "node scripts/raw-payload-audit.mjs --gate",
    "test:governance": "node scripts/test-governance.mjs",
    "test:visual-audit": "node scripts/visual-audit.mjs --full",
    "test:acceptance": "node scripts/acceptance-gate.mjs --gate",
    "test:acceptance:final": "node scripts/acceptance-gate.mjs --final --gate",
    "test:acceptance:assemble": "node scripts/assemble-acceptance-results.mjs --final",
    "test:evidence:record": "node scripts/record-evidence-command.mjs --final",
    "test:e2e": "node scripts/run-e2e.mjs test --browser=chromium",
    "test:e2e:release": "node scripts/release-browser-gate.mjs",
    "test:smoke": "node scripts/webui-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vue-flow/core": "^1.48.2",
    "echarts": "^6.1.0",
    "elkjs": "^0.10.2",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.38",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1"
  }
}
