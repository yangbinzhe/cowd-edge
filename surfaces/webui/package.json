{
  "name": "@cowd-edge/webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && cp dist/index.dev.html dist/index.html && cp dist/index.dev.html index.html && rm -rf assets/app && mkdir -p assets && cp -R dist/assets/app assets/app",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.mjs",
    "test": "vitest run && npm run test:i18n && node scripts/api-matrix.mjs --gate && node scripts/mfg-write-contracts.mjs && node scripts/capability-parity.mjs --gate && node scripts/secondary-section-contract.mjs --gate && node scripts/raw-payload-audit.mjs --gate && node scripts/tool-operations-gate.mjs --gate && node scripts/command-actions-gate.mjs --gate",
    "test:unit": "vitest run",
    "test:i18n": "node scripts/i18n-source-gate.mjs --gate && node scripts/i18n-coverage-gate.mjs --gate",
    "test:api-matrix": "node scripts/api-matrix.mjs --gate",
    "test:mfg-contracts": "node scripts/mfg-write-contracts.mjs",
    "test:capability-parity": "node scripts/capability-parity.mjs --gate",
    "test:secondary-sections": "node scripts/secondary-section-contract.mjs --gate",
    "test:raw-payload": "node scripts/raw-payload-audit.mjs --gate",
    "test:tool-ops": "node scripts/tool-operations-gate.mjs --gate",
    "test:command-actions": "node scripts/command-actions-gate.mjs --gate",
    "test:visual-audit": "node scripts/visual-audit.mjs",
    "test:e2e": "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-/snap/bin/chromium} playwright test --browser=chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "7.13.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue-flow/core": "^1.48.2",
    "@vue/test-utils": "^2.4.11",
    "echarts": "^5.6.0",
    "elkjs": "^0.10.2",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.2.0",
    "pinia": "^2.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vue": "^3.5.38",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.6.4"
  }
}
